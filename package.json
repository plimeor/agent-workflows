{
	"name": "@plimeor/agent-workflows",
	"version": "0.1.3",
	"description": "Deterministic multi-agent workflow orchestration for CLI coding agents.",
	"homepage": "https://github.com/plimeor/agent-workflows",
	"license": "MIT OR Apache-2.0",
	"type": "module",
	"bin": {
		"agent-workflows": "./src/cli/cli.ts"
	},
	"exports": {
		".": "./src/engine/index.ts"
	},
	"module": "./src/engine/index.ts",
	"engines": {
		"bun": ">=1.1"
	},
	"files": [
		"src",
		"workflows",
		"LICENSE-MIT",
		"LICENSE-APACHE"
	],
	"bugs": {
		"url": "https://github.com/plimeor/agent-workflows/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/plimeor/agent-workflows.git"
	},
	"publishConfig": {
        "access": "public"
    },
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@plimeor/command-kit": "^0.1.5",
		"@plimeor/harness": "^0.1.2",
		"@valibot/to-json-schema": "^1.6.0",
		"valibot": "^1.3.1",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@types/bun": "^1.3.11",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"agent-workflows": "bun src/cli/cli.ts",
		"check": "tsc --noEmit",
		"lint": "biome check src test evals/scripts",
		"test": "bun test test evals/scripts",
		"prepack": "bun src/cli/cli.ts --help >/dev/null"
	}
}
